{
	"name": "@tevm/cli",
	"version": "1.0.0-rc.151",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/evmts/tevm-cli.git",
		"directory": "packages/tevm-cli"
	},
	"homepage": "https://cli.tevm.sh/",
	"bugs": {
		"url": "https://github.com/evmts/tevm-cli/issues"
	},
	"bin": {
		"tevm": "dist/cli.js"
	},
	"type": "module",
	"main": "dist/cli.js",
	"module": "dist/cli.js",
	"sideEffects": true,
	"types": "dist/cli.d.ts",
	"exports": {
		".": {
			"types": "./dist/cli.d.ts",
			"default": "./dist/cli.js"
		},
		"./package.json": "./package.json"
	},
	"engines": {
		"node": "^24.0.0"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "pnpm run build:app",
		"build:app": "tsc --skipLibCheck && mkdir -p dist/utils && cp src/utils/bun.lockb dist/utils/",
		"dev": "tsx src/cli.tsx",
		"format": "biome format . --write",
		"lint": "biome check . --write --unsafe",
		"lint:check": "biome check . --verbose",
		"test": "pnpm run build && vitest run",
		"test:coverage": "pnpm run build && vitest run --coverage",
		"test:run": "vitest run",
		"typecheck": "tsc --noEmit --skipLibCheck"
	},
	"files": [
		"dist"
	],
	"dependencies": {
		"@tanstack/react-query": "^5.100.11",
		"@tevm/actions": "^1.0.0-next.149",
		"@tevm/base-bundler": "^1.0.0-next.149",
		"@tevm/bundler-cache": "^1.0.0-next.148",
		"@tevm/common": "^1.0.0-next.148",
		"@tevm/config": "^1.0.0-next.148",
		"@tevm/jsonrpc": "^1.0.0-next.148",
		"@tevm/memory-client": "^1.0.0-next.148",
		"@tevm/utils": "^1.0.0-next.148",
		"@types/glob": "^9.0.0",
		"@types/json-bigint": "^1.0.4",
		"effect": "3.21.2",
		"figures": "^6.1.0",
		"glob": "^13.0.6",
		"ink": "^7.0.3",
		"ink-big-text": "^2.0.0",
		"ink-gradient": "^4.0.0",
		"ink-select-input": "^6.2.0",
		"ink-spinner": "^5.0.0",
		"ink-text-input": "^6.0.0",
		"json-bigint": "^1.0.0",
		"pastel": "^4.0.1",
		"react": "^19.2.6",
		"solc": "^0.8.35",
		"viem": "2.37.12",
		"zod": "^4.4.3",
		"zustand": "^5.0.13"
	},
	"devDependencies": {
		"@sindresorhus/tsconfig": "^8.1.0",
		"@tevm/tsconfig": "^1.0.0-next.142",
		"@types/ink-big-text": "^1.2.4",
		"@types/ink-gradient": "^2.0.4",
		"@types/node": "^24.10.9",
		"@types/react": "^19.2.14",
		"ink-testing-library": "^4.0.0",
		"tsx": "^4.22.2",
		"typescript": "^6.0.3",
		"vitest": "^4.1.6"
	}
}
